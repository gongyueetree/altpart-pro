# ───────── AltPart AI 环境变量 ─────────
# 部署时在 Vercel 控制台 Settings → Environment Variables 配置，配完需 Redeploy

# 【必填】Gemini API Key — AI候选推荐与参数查询
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 【推荐】ezPLM 元器件库 API Key（HMAC签名，服务端持有，勿加 VITE_ 前缀）
# 配置后：器件参数、参考设计、可下载资源走真实 ezPLM 数据
EZPLM_API_KEY=

# 【可选】DigiKey API — 实时价格与库存
# 申请: https://developer.digikey.com
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SITE=US

# 【可选】Mouser API — 实时价格与库存
# 申请: https://www.mouser.com/api-hub/
MOUSER_API_KEY=

# 未配置分销商 API 时，价格/库存自动由 Gemini 估算并标注"仅供参考"
