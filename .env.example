# ───────── AltPart AI 环境变量 ─────────
# 部署时在 Vercel 控制台 Settings → Environment Variables 配置，配完需 Redeploy

# 【必填】Gemini API Key — AI候选推荐与参数查询
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 【推荐】ezPLM 元器件库 API Key（HMAC签名，服务端持有，勿加 VITE_ 前缀）
# 配置后：器件参数、参考设计、可下载资源走真实 ezPLM 数据
EZPLM_API_KEY=
# 可选：默认 https://www.ezplm.cn（手册示例为 http）
EZPLM_BASE_URL=

# 【推荐】DigiKey API — 实时价格库存 + 器件品类/参数（ezPLM 未收录时的权威数据源）
# 申请: https://developer.digikey.com
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SITE=US

# 【推荐】Mouser API — 实时价格库存 + 器件品类/参数
# 申请: https://www.mouser.com/api-hub/
MOUSER_API_KEY=

# 未配置分销商 API 时，价格/库存自动由 Gemini 估算并标注"仅供参考"

# ───────── 数据优先级 ─────────
# 器件参数：ezPLM（已审核）→ DigiKey/Mouser（厂商申报）→ AI 联网/知识（兜底，降权）
# 价格库存：DigiKey/Mouser 实时 → AI 估算（明确标注仅供参考）
# eCAD 符号：真实 .kicad_sym → 品类标准符号（电阻/电容等标准图形）→ 按引脚数推算（标注 AI生成）
# eCAD 封装：真实 .kicad_mod → 依封装名合成（标注 AI生成，不可用于生产）
