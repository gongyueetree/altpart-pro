# ───────── AltPart Pro 环境变量 ─────────
# 部署时在 Vercel 控制台 Settings → Environment Variables 配置，配完需 Redeploy

# 【必填】Gemini API Key — AI 候选召回、参数补充与解释
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 【推荐】ezPLM 元器件库 API Key（HMAC 签名，服务端持有，勿加 VITE_ 前缀）
EZPLM_API_KEY=
# 可选；默认 https://www.ezplm.cn
EZPLM_BASE_URL=https://www.ezplm.cn

# 【推荐】DigiKey API — 精确 MPN 参数、实时价格和库存
# 申请: https://developer.digikey.com
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SITE=US

# 【推荐】Mouser API — 精确 MPN 参数、实时价格和库存
# 申请: https://www.mouser.com/api-hub/
MOUSER_API_KEY=

# 【生产必填】/analyze → /recommend 上下文签名密钥；至少 32 个随机字节
# 未配置时服务仍可运行，但 recommend 会重新解析原型号，不信任客户端对象
ANALYSIS_CONTEXT_SECRET=

# 【生产推荐】企业部署开启 API Key 鉴权；多个 key 用逗号分隔
# 公共 EETree 部署可保持 false，并依赖下面的限流保护上游额度
ALTPART_REQUIRE_AUTH=false
ALTPART_API_KEYS=
# 反馈导出等管理接口始终要求独立管理员 key
ALTPART_ADMIN_API_KEYS=

# 单实例内存限流；生产多实例部署应由网关/Redis 实现全局限流
ALTPART_RATE_LIMIT=60
ALTPART_RATE_WINDOW_SECONDS=60

# CORS 允许来源白名单（逗号分隔）；生产环境不要使用 *
# 示例：https://altpart.eetree.cn,https://www.ezplm.cn
ALLOWED_ORIGINS=*

# ───────── 数据优先级 ─────────
# 器件参数：ezPLM（已审核）→ DigiKey/Mouser（精确 MPN）→ AI（兜底，降权）
# 价格库存：DigiKey/Mouser 精确报价 → AI 估算（不参与低成本正式推荐）
# 生命周期/合规：仅使用可追溯的精确变体证据；无证据一律 Unknown
# eCAD 符号：真实文件 → 品类标准图形 → 推算图形（后两者不可用于直接替代证明）
